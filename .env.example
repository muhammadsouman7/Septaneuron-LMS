# Copy to .env for local work. On Vercel, add the same names under Project > Settings > Environment Variables.
# NEVER commit real values (.env is already in .gitignore).

FLASK_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# Supabase (Project Settings > API Keys). The secret key is server-side only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_BUCKET=lms-files

# Email (Gmail needs 2-Step Verification + an App Password; Brevo/Resend SMTP also work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=internships@yourdomain.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=internships@yourdomain.com
MAIL_FROM_NAME=Septaneuron Internships

# Public URL used for links inside emails
PORTAL_BASE_URL=https://septaneuron.com

# Optional
# DEFAULT_INTERN_PASSWORD=Septa@CNIC
# INTERN_EMAIL_DOMAINS=gmail.com
